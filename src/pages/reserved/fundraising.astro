---
import ReservedPage from '../../components/ReservedPage.astro';
import SheetTable from '../../components/SheetTable.astro';
// Content: the "Owners" tab of the CCFI LP Target List, synced from Google Sheets
// (scripts/apps-script/reserved-sync.gs -> worker/sync.js).
---
<ReservedPage lang="en" kind="section" section="fundraising">
  <SheetTable
    lang="en"
    summary={['Owner / decision unit', 'First contact', 'Stage', 'Relationship type', 'Net income, all yrs (EUR)']}
    lastLine={['Stage']}
    filters={['First contact', 'Relationship type']}
    numeric={['Net income, all yrs (EUR)']}
    widths={{
      'Owner / decision unit': '30%',
      'First contact': '11%',
      Stage: '27%',
      'Relationship type': '18%',
      'Net income, all yrs (EUR)': '14%',
    }}
    activeField="Stage"
    timeline="Stage"
    groups={[
      { title: { en: 'Who', pt: 'Quem' }, fields: ['Family or principal', 'Key people'] },
      { title: { en: 'Holdings', pt: 'Participações' }, fields: ['Headline assets', 'Entities held'] },
    ]}
    lists={['Entities held']}
    footer={['Basis', 'Note']}
    hide={['#']}
  />
</ReservedPage>
