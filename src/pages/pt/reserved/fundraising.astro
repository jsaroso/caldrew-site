---
import ReservedPage from '../../../components/ReservedPage.astro';
import SheetTable from '../../../components/SheetTable.astro';
// Content: the "Owners" tab of the CCFI LP Target List, synced from Google Sheets
// (scripts/apps-script/reserved-sync.gs -> worker/sync.js).
---
<ReservedPage lang="pt" kind="section" section="fundraising">
  <SheetTable
    lang="pt"
    summary={['Owner / decision unit', 'First contact', 'Stage']}
    lastLine={['Stage']}
    filters={['First contact']}
    widths={{
      'Owner / decision unit': '38%',
      'First contact': '14%',
      Stage: '48%',
    }}
    activeField="Stage"
    dateSort={['Stage']}
    defaultSort={{ col: 'Stage', dir: -1 }}
    timeline="Stage"
    groups={[
      { title: { en: 'Who', pt: 'Quem' }, fields: ['Family or principal', 'Key people'] },
      { title: { en: 'Holdings', pt: 'Participações' }, fields: ['Headline assets', 'Entities held'] },
    ]}
    lists={['Entities held']}
    footer={['Net income, all yrs (EUR)', 'Basis', 'Note']}
    hide={['#', 'Relationship type']}
    labels={{
      'Owner / decision unit': 'Investidor / centro de decisão',
      'First contact': 'Primeiro contacto',
      Stage: 'Ponto de situação',
      'Family or principal': 'Família ou responsável',
      'Key people': 'Pessoas-chave',
      'Headline assets': 'Principais ativos',
      'Entities held': 'Entidades detidas',
      'Net income, all yrs (EUR)': 'Resultado líquido, todos os anos (EUR)',
      Basis: 'Base',
      Note: 'Nota',
    }}
    values={{ disclosed: 'divulgado', inferred: 'inferido', verified: 'verificado', 'direct contact': 'contacto direto' }}
  />
</ReservedPage>
