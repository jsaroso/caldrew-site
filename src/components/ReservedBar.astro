---
// Sub-navigation shown on every reserved page. The Worker removes tabs the visitor
// may not open (data-section) and fills in who is signed in (data-user-email).
import { r, SECTIONS } from '../reserved-i18n.js';
const { lang = 'en', current = null } = Astro.props;
const c = r[lang];
---
<div class="cd-rbar">
  <div class="cd-rbar-inner">
    <a href={c.base} class:list={['cd-rbar-home', { 'is-current': current === null }]}>{c.area}</a>
    <nav class="cd-rbar-tabs" aria-label={c.area} data-tabs>
      {SECTIONS.map((s) => (
        <a href={`${c.base}/${s}`} data-section={s} class:list={['cd-rbar-tab', { 'is-current': current === s }]} aria-current={current === s ? 'page' : undefined}>{c.sections[s].name}</a>
      ))}
    </nav>
    <div class="cd-rbar-user w-dropdown" data-dropdown>
      <button type="button" class="cd-rbar-me w-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
        <span class="cd-rbar-email" data-user-email></span>
        <span class="cd-rbar-caret" aria-hidden="true"></span>
      </button>
      <nav class="cd-rbar-menu w-dropdown-list">
        <a href={`${c.base}/settings`} class="cd-rbar-item">{c.emailUpdates}</a>
        <a href="/reserved/signout" class="cd-rbar-item">{c.signOut}</a>
      </nav>
    </div>
  </div>
</div>
