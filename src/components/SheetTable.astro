---
// Renders a synced Google Sheet tab (worker/sync.js) as a searchable, filterable table.
// The Worker fills <script id="reserved-data"> with the latest data on every request,
// so the page is always current and the data never sits in a public file.
//
// Table
//   summary:  sheet headers shown as columns, in order
//   lastLine: headers where the table shows only the latest line (e.g. a dated log)
//   numeric:  headers aligned right
//   widths:   fixed column widths by header (e.g. '30%'), so the layout never shifts
//   filters:  headers offered as dropdown filters
//   activeField: header used by the "with activity only" switch
//   dateSort: headers sorted by the most recent d/m date in their text (e.g. a dated log)
// Click a column header to sort; click again to reverse; a third click restores the sheet order.
// Expanded row (one open at a time)
//   timeline: header shown as a dated timeline on the left (one line = one step)
//   groups:   [{ title: {en, pt}, fields: [headers] }] shown on the right
//   lists:    headers whose lines are list items ("- A\n- B")
//   footer:   headers shown small at the bottom
//   hide:     headers never shown
// Any other column not mentioned anywhere still appears, in a final group, so nothing is lost.
const {
  lang = 'en',
  summary = [],
  lastLine = [],
  filters = [],
  numeric = [],
  widths = {},
  activeField = null,
  dateSort = [],
  timeline = null,
  groups = [],
  lists = [],
  footer = [],
  hide = [],
} = Astro.props;
const pt = lang === 'pt';
const t = pt
  ? {
      search: 'Pesquisar',
      searchPh: 'Nome, pessoa, ativo…',
      all: 'Todos',
      warm: 'Só caminhos próximos',
      active: 'Só com atividade',
      showing: 'A mostrar {n} de {total}',
      synced: 'Sincronizado com a folha a {date}',
      none: 'Ainda não há dados sincronizados.',
      noMatch: 'Nenhum resultado para estes filtros.',
      warmBadge: 'Caminho próximo',
      activity: 'Atividade',
      noActivity: 'Ainda sem atividade registada.',
      other: 'Outros',
      sortHint: 'Ordenar',
    }
  : {
      search: 'Search',
      searchPh: 'Name, person, asset…',
      all: 'All',
      warm: 'Warm paths only',
      active: 'With activity only',
      showing: 'Showing {n} of {total}',
      synced: 'Synced from the sheet on {date}',
      none: 'No data has been synced yet.',
      noMatch: 'Nothing matches these filters.',
      warmBadge: 'Warm path',
      activity: 'Activity',
      noActivity: 'No activity logged yet.',
      other: 'Other',
      sortHint: 'Sort',
    };
const config = {
  summary, lastLine, filters, numeric, widths, activeField, dateSort,
  timeline, lists, footer, hide, lang, t,
  groups: groups.map((g) => ({ title: g.title[lang] || g.title.en, fields: g.fields })),
};
---
<div class="cd-st" data-sheet-table>
  <div class="cd-st-bar">
    <label class="cd-st-search">
      <span class="cd-st-label">{t.search}</span>
      <input type="search" placeholder={t.searchPh} data-q />
    </label>
    <div class="cd-st-filters" data-filters></div>
    <div class="cd-st-toggles">
      <label><input type="checkbox" data-warm /> {t.warm}</label>
      {activeField && <label><input type="checkbox" data-active /> {t.active}</label>}
    </div>
  </div>
  <p class="cd-st-meta"><span data-count></span><span data-synced></span></p>
  <div class="cd-st-scroll">
    <table class="cd-st-table">
      <thead><tr data-head></tr></thead>
      <tbody data-body></tbody>
    </table>
  </div>
  <p class="cd-st-empty" data-empty hidden></p>
</div>
<script is:inline id="reserved-data" type="application/json">null</script>
<script is:inline type="application/json" id="sheet-table-config" set:html={JSON.stringify(config)}></script>
<script is:inline>
  (function () {
    var root = document.querySelector('[data-sheet-table]');
    var cfg = JSON.parse(document.getElementById('sheet-table-config').textContent);
    var data = JSON.parse(document.getElementById('reserved-data').textContent || 'null');
    var t = cfg.t;
    var $ = function (sel) { return root.querySelector(sel); };
    var el = function (tag, cls, text) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    };
    var has = function (list, c) { return list.indexOf(c) >= 0; };

    if (!data || !data.rows || !data.rows.length) {
      $('.cd-st-bar').hidden = true;
      $('.cd-st-scroll').hidden = true;
      $('[data-empty]').hidden = false;
      $('[data-empty]').textContent = t.none;
      return;
    }

    var cols = data.columns;
    var at = function (name) { return cols.indexOf(name); };
    var cell = function (row, name) { return at(name) >= 0 ? String(row.cells[at(name)] || '') : ''; };
    var lines = function (s) { return String(s || '').split('\n').map(function (l) { return l.trim(); }).filter(Boolean); };
    var lastLine = function (s) { var l = lines(s); return l.length ? l[l.length - 1] : ''; };
    var empty = function (v) { v = String(v || '').trim(); return !v || v === '-'; };
    var summary = cfg.summary.filter(function (c) { return at(c) >= 0; });
    if (!summary.length) summary = cols.slice(0, 4);

    // Columns not placed anywhere still show, so a new sheet column is never lost.
    var placed = [].concat(summary.filter(function (c) { return !has(cfg.lastLine, c); }), cfg.timeline ? [cfg.timeline] : [], cfg.footer, cfg.hide);
    cfg.groups.forEach(function (g) { placed = placed.concat(g.fields); });
    var leftovers = cols.filter(function (c) { return !has(placed, c); });
    var groups = cfg.groups.slice();
    if (leftovers.length) groups.push({ title: t.other, fields: leftovers });

    // Text with clickable email addresses and phone numbers.
    var linkify = function (parent, text) {
      var re = /([A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,})|(\+\d[\d\s]{7,}\d)/gi;
      var last = 0, m;
      while ((m = re.exec(text))) {
        if (m.index > last) parent.appendChild(document.createTextNode(text.slice(last, m.index)));
        var a = el('a', 'cd-st-link', m[0]);
        a.href = m[1] ? 'mailto:' + m[1] : 'tel:' + m[2].replace(/\s/g, '');
        a.addEventListener('click', function (e) { e.stopPropagation(); });
        parent.appendChild(a);
        last = m.index + m[0].length;
      }
      if (last < text.length) parent.appendChild(document.createTextNode(text.slice(last)));
      return parent;
    };

    function field(row, c) {
      var v = cell(row, c);
      if (empty(v)) return null;
      var wrap = el('div', 'cd-st-field');
      wrap.appendChild(el('div', 'cd-st-flabel', c));
      if (has(cfg.lists, c)) {
        var ul = el('ul', 'cd-st-list');
        lines(v).forEach(function (l) { ul.appendChild(linkify(el('li'), l.replace(/^[-•]\s*/, ''))); });
        wrap.appendChild(ul);
      } else {
        var d = el('div', 'cd-st-fvalue');
        lines(v).forEach(function (l, i) {
          if (i) d.appendChild(el('br'));
          linkify(d, l);
        });
        wrap.appendChild(d);
      }
      return wrap;
    }

    function panel(row) {
      var p = el('div', 'cd-st-panel');
      if (cfg.timeline && at(cfg.timeline) >= 0) {
        var left = el('div', 'cd-st-activity');
        left.appendChild(el('div', 'cd-st-gtitle', t.activity));
        var steps = lines(cell(row, cfg.timeline));
        if (steps.length) {
          var ol = el('ol', 'cd-st-timeline');
          steps.forEach(function (s, i) {
            ol.appendChild(linkify(el('li', i === steps.length - 1 ? 'is-latest' : ''), s));
          });
          left.appendChild(ol);
        } else {
          left.appendChild(el('p', 'cd-st-muted', t.noActivity));
        }
        p.appendChild(left);
      }
      var right = el('div', 'cd-st-groups');
      groups.forEach(function (g) {
        var fields = g.fields.map(function (c) { return field(row, c); }).filter(Boolean);
        if (!fields.length) return;
        var box = el('section', 'cd-st-group');
        box.appendChild(el('div', 'cd-st-gtitle', g.title));
        fields.forEach(function (f) { box.appendChild(f); });
        right.appendChild(box);
      });
      p.appendChild(right);
      // Columns hidden on this screen (phones) move into the footer so they stay visible.
      var hiddenCols = summary.slice(1).filter(function (c) {
        var th = root.querySelector('thead th[data-col="' + c.replace(/"/g, '\\"') + '"]');
        return th && getComputedStyle(th).display === 'none';
      });
      var foot = hiddenCols.concat(cfg.footer).filter(function (c) { return !empty(cell(row, c)); });
      if (foot.length) {
        var f = el('div', 'cd-st-foot');
        foot.forEach(function (c) {
          var s = el('span');
          s.appendChild(el('span', 'cd-st-flabel', c));
          linkify(s, cell(row, c));
          f.appendChild(s);
        });
        p.appendChild(f);
      }
      return p;
    }

    // Header
    var sortCol = null, sortDir = 0; // 0 = sheet order, 1 = ascending, -1 = descending
    summary.forEach(function (c) {
      var th = el('th', has(cfg.numeric, c) ? 'is-num' : '');
      th.dataset.col = c;
      th.setAttribute('aria-sort', 'none');
      if (cfg.widths[c]) th.style.width = cfg.widths[c];
      var b = el('button', 'cd-st-sort');
      b.type = 'button';
      b.title = t.sortHint;
      b.appendChild(el('span', null, c));
      b.appendChild(el('span', 'cd-st-arrow'));
      b.addEventListener('click', function () {
        // Dates sort newest first on the first click; everything else A to Z.
        var first = has(cfg.dateSort, c) ? -1 : 1;
        if (sortCol !== c) { sortCol = c; sortDir = first; }
        else if (sortDir === first) sortDir = -first;
        else { sortCol = null; sortDir = 0; }
        root.querySelectorAll('thead th').forEach(function (h) {
          var on = h.dataset.col === sortCol;
          h.classList.toggle('is-sorted', on);
          h.classList.toggle('is-desc', on && sortDir < 0);
          h.setAttribute('aria-sort', on ? (sortDir > 0 ? 'ascending' : 'descending') : 'none');
        });
        render();
      });
      th.appendChild(b);
      $('[data-head]').appendChild(th);
    });

    // Sort keys. Empty values always go last, whichever the direction.
    var latestDate = function (text) {
      // Most recent "d/m" in the text, as a comparable number (month * 100 + day).
      // Months after the current one count as last year, so October stays before a January note.
      var best = null, now = new Date(), m, re = /\b(\d{1,2})\/(\d{1,2})\b/g;
      while ((m = re.exec(text))) {
        var d = +m[1], mo = +m[2];
        if (d < 1 || d > 31 || mo < 1 || mo > 12) continue;
        var y = mo > now.getMonth() + 1 ? -1 : 0;
        var key = (y + 1) * 10000 + mo * 100 + d;
        if (best === null || key > best) best = key;
      }
      return best;
    };
    var numberOf = function (v) {
      var s = String(v).replace(/[\s,]/g, '');
      var neg = /^\(.*\)$/.test(s);
      var n = parseFloat(s.replace(/[()]/g, ''));
      return isNaN(n) ? null : neg ? -n : n;
    };
    var sortKey = function (row, c) {
      var v = cell(row, c);
      if (empty(v)) return null;
      if (has(cfg.dateSort, c)) return latestDate(v);
      if (has(cfg.numeric, c)) return numberOf(v);
      return v.toLowerCase();
    };
    var collator = new Intl.Collator(cfg.lang === 'pt' ? 'pt-PT' : 'en', { sensitivity: 'base', numeric: true });
    var order = function (rows) {
      var list = rows.map(function (row, i) { return { row: row, i: i }; });
      if (!sortCol) return list;
      return list.sort(function (a, b) {
        var x = sortKey(a.row, sortCol), y = sortKey(b.row, sortCol);
        if (x === null && y === null) return a.i - b.i;
        if (x === null) return 1;
        if (y === null) return -1;
        var r = typeof x === 'number' ? x - y : collator.compare(x, y);
        return r ? r * sortDir : a.i - b.i;
      });
    };
    // Search covers what is shown on the page, never hidden columns.
    var searchable = cols.map(function (c, i) { return has(cfg.hide, c) ? -1 : i; }).filter(function (i) { return i >= 0; });
    var haystack = function (row) {
      return searchable.map(function (i) { return row.cells[i]; }).join(' ').toLowerCase();
    };

    // Dropdown filters
    var selects = {};
    var parts = function (v) { return String(v).split(/[\/;]/).map(function (x) { return x.trim(); }).filter(Boolean); };
    cfg.filters.filter(function (c) { return at(c) >= 0; }).forEach(function (c) {
      var values = {};
      data.rows.forEach(function (r) { parts(cell(r, c)).forEach(function (v) { values[v] = 1; }); });
      var label = el('label', 'cd-st-select');
      label.appendChild(el('span', 'cd-st-label', c));
      var s = el('select');
      s.appendChild(new Option(t.all, ''));
      Object.keys(values).sort().forEach(function (v) { s.appendChild(new Option(v, v)); });
      label.appendChild(s);
      $('[data-filters]').appendChild(label);
      selects[c] = s;
      s.addEventListener('change', render);
    });

    var fmtDate = new Intl.DateTimeFormat(cfg.lang === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'medium', timeStyle: 'short' });
    $('[data-synced]').textContent = t.synced.replace('{date}', fmtDate.format(new Date(data.updatedAt)));

    var visibleColumns = function () {
      return Array.prototype.filter.call(root.querySelectorAll('thead th'), function (th) {
        return getComputedStyle(th).display !== 'none';
      }).length || summary.length;
    };

    var openIndex = -1;
    function render() {
      var q = $('[data-q]').value.trim().toLowerCase();
      var warmOnly = $('[data-warm]').checked;
      var activeOnly = $('[data-active]') && $('[data-active]').checked;
      var body = $('[data-body]');
      body.textContent = '';
      var shown = 0;
      order(data.rows).forEach(function (item) {
        var row = item.row, i = item.i;
        if (warmOnly && !row.warm) return;
        if (activeOnly && empty(cell(row, cfg.activeField))) return;
        for (var c in selects) {
          var v = selects[c].value;
          if (v && !has(parts(cell(row, c)), v)) return;
        }
        if (q && haystack(row).indexOf(q) < 0) return;
        shown++;
        var isOpen = openIndex === i;

        var tr = el('tr', 'cd-st-row' + (row.warm ? ' is-warm' : '') + (isOpen ? ' is-open' : ''));
        tr.tabIndex = 0;
        tr.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        summary.forEach(function (c, ci) {
          var v = cell(row, c);
          if (has(cfg.lastLine, c)) v = lastLine(v);
          var td = el('td', has(cfg.numeric, c) ? 'is-num' : '');
          td.dataset.col = c;
          if (ci === 0) {
            var head = el('div', 'cd-st-namewrap');
            head.appendChild(el('span', 'cd-st-chevron'));
            var name = el('div');
            name.appendChild(el('span', 'cd-st-name', v));
            if (row.warm) name.appendChild(el('span', 'cd-st-badge', t.warmBadge));
            head.appendChild(name);
            td.appendChild(head);
          } else {
            // Allow line breaks after slashes ("MQP/MMV" -> "MQP/" + "MMV"), never mid-word.
            td.textContent = empty(v) ? '' : v.replace(/\//g, '/​');
          }
          tr.appendChild(td);
        });
        var toggle = function () {
          openIndex = isOpen ? -1 : i;
          render();
          if (!isOpen) {
            var opened = $('.cd-st-row.is-open');
            if (opened && opened.getBoundingClientRect().top < 80) opened.scrollIntoView({ block: 'start', behavior: 'smooth' });
          }
        };
        tr.addEventListener('click', toggle);
        tr.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
        body.appendChild(tr);

        if (isOpen) {
          var dtr = el('tr', 'cd-st-detail' + (row.warm ? ' is-warm' : ''));
          var td = el('td');
          td.colSpan = visibleColumns(); // only the columns visible (some are hidden on phones)
          td.appendChild(panel(row));
          dtr.appendChild(td);
          body.appendChild(dtr);
        }
      });
      $('[data-count]').textContent = t.showing.replace('{n}', shown).replace('{total}', data.rows.length);
      $('[data-empty]').hidden = shown > 0;
      $('[data-empty]').textContent = t.noMatch;
    }
    $('[data-q]').addEventListener('input', render);
    $('[data-warm]').addEventListener('change', render);
    if ($('[data-active]')) $('[data-active]').addEventListener('change', render);
    window.matchMedia('(max-width: 767px)').addEventListener('change', render);
    render();
  })();
</script>
