{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caldrew-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Everything else is served as static files without running the Worker.
    "run_worker_first": ["/api/*", "/press", "/press/*", "/press.html", "/pt/press", "/pt/press/*", "/pt/press.html"]
  },
  // Cloudflare Email Routing "send_email" binding. Can only deliver to verified addresses.
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "enquiries@caldrew.com" }
  ],
  "vars": {
    "CONTACT_TO": "enquiries@caldrew.com",
    // Must be an address on a domain with Email Routing enabled (see README).
    "CONTACT_FROM": "website@notify.caldrew.com",
    // Google Workspace mailbox that sends Press sign-in emails (see README).
    "PRESS_MAIL_FROM": "enquiries@caldrew.com"
  },
  // Press sign-in: 10 attempts per minute per IP, 3 emails per minute per address.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "MAIL_LIMITER", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
  ],
  // Secrets (not in this file): PRESS_SESSION_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN. See README.
  "observability": { "enabled": true },
  // Staging: deployed from the `staging` branch with `wrangler deploy --env staging`,
  // served at next.caldrew.com behind Cloudflare Access (see README).
  "env": {
    "staging": {
      "name": "caldrew-site-staging",
      "workers_dev": false,
      "send_email": [
        { "name": "SEND_EMAIL", "destination_address": "enquiries@caldrew.com" }
      ],
      "vars": {
        "STAGING": "1",
        "CONTACT_TO": "enquiries@caldrew.com",
        "CONTACT_FROM": "website@notify.caldrew.com",
        "PRESS_MAIL_FROM": "enquiries@caldrew.com"
      },
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "MAIL_LIMITER", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } }
      ],
      "routes": [{ "pattern": "next.caldrew.com", "custom_domain": true }]
    }
  }
  // Custom domains are attached at cutover (see README):
  // "routes": [{ "pattern": "www.caldrew.com", "custom_domain": true }, { "pattern": "caldrew.com", "custom_domain": true }]
}
