{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caldrew-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Lets the Worker import the logo image for the sign-in emails.
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Everything else is served as static files without running the Worker.
    "run_worker_first": ["/api/*", "/reserved", "/reserved/*", "/reserved.html", "/pt/reserved", "/pt/reserved/*", "/pt/reserved.html", "/press", "/press/*", "/press.html", "/pt/press", "/pt/press/*", "/pt/press.html"]
  },
  // Cloudflare Email Routing "send_email" binding. Can only deliver to verified addresses.
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "enquiries@caldrew.com" },
    // Cloudflare Email Sending: reserved-area sign-in emails to anyone on the list, only from this sender.
    { "name": "PRESS_EMAIL", "allowed_sender_addresses": ["noreply@notify.caldrew.com"] }
  ],
  "vars": {
    "CONTACT_TO": "enquiries@caldrew.com",
    // Must be an address on a domain with Email Routing enabled (see README).
    "CONTACT_FROM": "website@notify.caldrew.com",
    // Sender of the reserved-area sign-in emails (Cloudflare Email Sending).
    "PRESS_MAIL_FROM": "noreply@notify.caldrew.com"
  },
  // Reserved-area sign-in: 10 attempts per minute per IP, 3 emails per minute per address.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "MAIL_LIMITER", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
  ],
  // Secret (not in this file): PRESS_SESSION_SECRET. See README.
  "observability": { "enabled": true },
  // Staging: deployed from the `staging` branch with `wrangler deploy --env staging`,
  // served at next.caldrew.com behind Cloudflare Access (see README).
  "env": {
    "staging": {
      "name": "caldrew-site-staging",
      "workers_dev": false,
      "send_email": [
        { "name": "SEND_EMAIL", "destination_address": "enquiries@caldrew.com" },
        { "name": "PRESS_EMAIL", "allowed_sender_addresses": ["noreply@notify.caldrew.com"] }
      ],
      "vars": {
        "STAGING": "1",
        "CONTACT_TO": "enquiries@caldrew.com",
        "CONTACT_FROM": "website@notify.caldrew.com",
        "PRESS_MAIL_FROM": "noreply@notify.caldrew.com"
      },
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "MAIL_LIMITER", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } }
      ],
      "routes": [{ "pattern": "next.caldrew.com", "custom_domain": true }]
    }
  }
  // Custom domains are attached at cutover (see README):
  // "routes": [{ "pattern": "www.caldrew.com", "custom_domain": true }, { "pattern": "caldrew.com", "custom_domain": true }]
}
